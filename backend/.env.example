# ORIGIN Backend Environment Configuration Template
# Duplicate this file to .env or configure in your deployment orchestrator

ORIGIN_ENVIRONMENT=development
ORIGIN_JWT_SECRET=replace_with_a_cryptographically_secure_random_string_at_least_32_bytes
ORIGIN_JWT_ALGORITHM=HS256
ORIGIN_JWT_ISSUER=origin-api
ORIGIN_JWT_AUDIENCE=origin-client
ORIGIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ORIGIN_REFRESH_TOKEN_EXPIRE_DAYS=7
ORIGIN_COOKIE_SECURE=false
ORIGIN_COOKIE_SAMESITE=lax
ORIGIN_LOGIN_MAX_ATTEMPTS=5
ORIGIN_LOGIN_WINDOW_SECONDS=60
ORIGIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ORIGIN_DATABASE_PATH=backend/data/origin.db
